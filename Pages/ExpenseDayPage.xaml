<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             SafeAreaEdges="SoftInput"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             xmlns:m="clr-namespace:DayLogger.Models"
             x:Class="DayLogger.Pages.ExpenseDayPage"
             x:Name="Root">

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label x:Name="DateLabel" FontAttributes="Bold" FontSize="15" />
            <Label x:Name="SummaryLabel" Style="{StaticResource Caption}" FontSize="10" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid>
    <c:OneUiScaffold x:Name="Scaffold">
        <c:OneUiScaffold.Aside>
            <VerticalStackLayout Padding="16,16,16,0" Spacing="8">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses, Source={x:Reference Root}}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Expense">
                            <Border Padding="12">
                                <Border.Behaviors>
                                    <c:LongPressBehavior HandleTap="True" Tapped="OnExpenseTapped" Pressed="OnExpenseLongPressed" />
                                </Border.Behaviors>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" />
                                            <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding LinkText}" IsVisible="{Binding HasLink}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding ReceiptMark}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding AmountText}" IsVisible="{Binding IsSpend}" VerticalOptions="Center" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="{Binding AmountText}" IsVisible="{Binding IsPayback}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                    </Grid>
                                    <!-- How much of this spend has come back, as a hairline fill under the row. -->
                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasSettle}">
                                        <Label Text="{Binding SettleText}" Style="{StaticResource Caption}" />
                                        <ProgressBar Progress="{Binding BackFraction}" ProgressColor="{DynamicResource Primary}" BackgroundColor="{DynamicResource Line}" />
                                    </VerticalStackLayout>
                                    <c:Reveal IsOpen="{Binding IsExpanded}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding PaybackLines}" IsVisible="{Binding HasPaybackLines}" Style="{StaticResource Caption}" />
                                            <Image Source="{Binding ReceiptImage}" IsVisible="{Binding HasReceipt}" HeightRequest="180" Aspect="AspectFit" />
                                        </VerticalStackLayout>
                                    </c:Reveal>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </c:OneUiScaffold.Aside>

        <VerticalStackLayout Padding="16">
            <Border Padding="12" Style="{StaticResource Section}">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="FormTitle" Text="NEW ENTRY" Style="{StaticResource Caption}" />
                    <!-- Pivot-style switch: the active word is large, the other muted. -->
                    <HorizontalStackLayout Spacing="18">
                        <Label x:Name="SpentTab" Text="spent" FontSize="24">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSpentTabTapped" /></Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="BackTab" Text="got back" FontSize="24">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTabTapped" /></Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <VerticalStackLayout x:Name="LinkBox" IsVisible="False" Spacing="6">
                        <Label Text="SETTLES (OPTIONAL)" Style="{StaticResource Caption}" />
                        <c:ChipGroup x:Name="LinkChips" AllowDeselect="True" SelectionChanged="OnLinkChanged" />
                    </VerticalStackLayout>
                    <c:ChipGroup x:Name="SubChips" AllowDeselect="True" IsVisible="False" />
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="TitleEntry" Placeholder="title" ReturnType="Next" /></Border>
                        <Border Grid.Column="1" Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="AmountEntry" Placeholder="amount" Keyboard="Numeric" /></Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="PersonEntry" Placeholder="with (optional): shop, vendor, person" TextChanged="OnPersonChanged" /></Border>
                        <Button Grid.Column="1" Text="CONTACTS" Clicked="OnPickContactClicked" />
                    </Grid>
                    <FlexLayout x:Name="PersonSuggestions" Wrap="Wrap" />
                    <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="DescriptionEntry" Placeholder="description (optional)" /></Border>

                    <Border Padding="12,6" Style="{StaticResource ControlBox}">
                        <Entry x:Name="TagsEntry" Placeholder="tags (optional): home, quick" TextChanged="OnTagsChanged" />
                    </Border>
                    <FlexLayout x:Name="TagSuggestions" Wrap="Wrap" />

                    <Grid x:Name="ExpectRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="expecting some of this back" />
                            <Label Text="a loan, a deposit, a booking that may be refunded" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ExpectSwitch" Grid.Column="1" />
                    </Grid>

                    <Label Text="RECEIPT (OPTIONAL)" Style="{StaticResource Caption}" />
                    <Border x:Name="ReceiptBox" IsVisible="False" Padding="4" Style="{StaticResource ControlBox}">
                        <Image x:Name="ReceiptImage" HeightRequest="180" Aspect="AspectFit" />
                    </Border>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <Button x:Name="CaptureButton" Text="📷 CAPTURE" Clicked="OnCaptureClicked" />
                        <Button Grid.Column="1" Text="🖼️ PICK" Clicked="OnPickClicked" />
                        <Button x:Name="RemoveReceiptButton" Grid.Column="2" Text="✕" IsVisible="False" Clicked="OnRemoveReceiptClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Text="SAVE" Clicked="OnSaveClicked" />
                        <Button x:Name="CancelButton" Grid.Column="1" Text="CANCEL" Clicked="OnCancelClicked" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </c:OneUiScaffold>

    <!-- Press-and-hold menu for an entry (edit, delete). -->
    <c:ActionBar x:Name="Menu" />
    </Grid>
</ContentPage>
