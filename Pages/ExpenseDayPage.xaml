<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             xmlns:m="clr-namespace:DayLogger.Models"
             x:Class="DayLogger.Pages.ExpenseDayPage"
             x:Name="Root">

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label x:Name="DateLabel" FontAttributes="Bold" FontSize="15" />
            <Label x:Name="SummaryLabel" Style="{StaticResource Caption}" FontSize="10" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <c:OneUiScaffold x:Name="Scaffold">
        <c:OneUiScaffold.Aside>
            <VerticalStackLayout Padding="16,16,16,0" Spacing="8">
                <!-- Meals logged this day count towards the total; tap to open them. -->
                <Border x:Name="MealsCard" Padding="12" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMealsCardTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="🍽️ MEALS" Style="{StaticResource Caption}" />
                            <Label x:Name="MealsLabel" />
                        </VerticalStackLayout>
                        <Label x:Name="MealsAmountLabel" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" />
                    </Grid>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses, Source={x:Reference Root}}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Expense">
                            <Border Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExpenseTapped" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <c:LongPressBehavior Pressed="OnExpenseLongPressed" />
                                </Border.Behaviors>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Title}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding ReceiptMark}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding AmountText}" VerticalOptions="Center" FontAttributes="Bold" />
                                    </Grid>
                                    <c:Reveal IsOpen="{Binding IsExpanded}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Caption}" />
                                            <Image Source="{Binding ReceiptImage}" IsVisible="{Binding HasReceipt}" HeightRequest="180" Aspect="AspectFit" />
                                        </VerticalStackLayout>
                                    </c:Reveal>
                                    <c:Reveal IsOpen="{Binding ShowActions}">
                                        <c:CardActions ActionA="Edit" ActionAInvoked="OnEditAction" ActionB="Delete" ActionBInvoked="OnDeleteAction" />
                                    </c:Reveal>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </c:OneUiScaffold.Aside>

        <VerticalStackLayout Padding="16">
            <Border Padding="12" Style="{StaticResource Section}">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="FormTitle" Text="NEW EXPENSE" Style="{StaticResource Caption}" />
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="TitleEntry" Placeholder="title" ReturnType="Next" /></Border>
                        <Border Grid.Column="1" Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="AmountEntry" Placeholder="amount" Keyboard="Numeric" /></Border>
                    </Grid>
                    <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="DescriptionEntry" Placeholder="description (optional)" /></Border>

                    <Label Text="RECEIPT (OPTIONAL)" Style="{StaticResource Caption}" />
                    <Border x:Name="ReceiptBox" IsVisible="False" Padding="4" Style="{StaticResource ControlBox}">
                        <Image x:Name="ReceiptImage" HeightRequest="180" Aspect="AspectFit" />
                    </Border>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <Button x:Name="CaptureButton" Text="📷 CAPTURE" Clicked="OnCaptureClicked" />
                        <Button Grid.Column="1" Text="🖼️ PICK" Clicked="OnPickClicked" />
                        <Button x:Name="RemoveReceiptButton" Grid.Column="2" Text="✕" IsVisible="False" Clicked="OnRemoveReceiptClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Text="SAVE" Clicked="OnSaveClicked" />
                        <Button x:Name="CancelButton" Grid.Column="1" Text="CANCEL" Clicked="OnCancelClicked" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
