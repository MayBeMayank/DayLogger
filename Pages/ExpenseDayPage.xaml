<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             SafeAreaEdges="SoftInput"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             xmlns:m="clr-namespace:DayLogger.Models"
             x:Class="DayLogger.Pages.ExpenseDayPage"
             x:Name="Root">

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label x:Name="DateLabel" FontAttributes="Bold" FontSize="15" />
            <Label x:Name="SummaryLabel" Style="{StaticResource Caption}" FontSize="10" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid>
    <c:OneUiScaffold x:Name="Scaffold" ManualEntrance="True">
        <c:OneUiScaffold.Aside>
            <VerticalStackLayout Padding="16,16,16,0" Spacing="8">
                <!-- What went where on this day, one line per category (shown when more than one is involved). -->
                <Border x:Name="BreakdownBox" IsVisible="False" Padding="12">
                    <VerticalStackLayout x:Name="BreakdownList" Spacing="4" />
                </Border>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses, Source={x:Reference Root}}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Expense">
                            <Border Padding="0">
                                <Border.Behaviors>
                                    <c:LongPressBehavior HandleTap="True" Tapped="OnExpenseTapped" Pressed="OnExpenseLongPressed" />
                                </Border.Behaviors>
                                <!-- The card itself fills from the left as money comes back. -->
                                <c:FillGrid Fraction="{Binding BackFraction}">
                                <VerticalStackLayout Padding="12" Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <c:Avatar Name="{Binding PersonName}" Photo="{Binding PersonPhoto}" Size="36" IsVisible="{Binding HasPerson}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" />
                                            <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding LinkText}" IsVisible="{Binding HasLink}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding SettleText}" IsVisible="{Binding HasSettle}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding ReceiptMark}" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding AmountText}" IsVisible="{Binding IsSpend}" VerticalOptions="Center" FontAttributes="Bold" />
                                        <Label Grid.Column="3" Text="{Binding AmountText}" IsVisible="{Binding IsPayback}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
                                    </Grid>
                                    <c:Reveal IsOpen="{Binding IsExpanded}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding PaybackLines}" IsVisible="{Binding HasPaybackLines}" Style="{StaticResource Caption}" />
                                            <Image Source="{Binding ReceiptImage}" IsVisible="{Binding HasReceipt}" HeightRequest="180" Aspect="AspectFit" />
                                        </VerticalStackLayout>
                                    </c:Reveal>
                                </VerticalStackLayout>
                                </c:FillGrid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </c:OneUiScaffold.Aside>

        <VerticalStackLayout Padding="16">
            <Border Padding="12" Style="{StaticResource Section}">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="FormTitle" Text="NEW ENTRY" Style="{StaticResource SectionLabel}" />
                    <!-- Pivot-style switch: the active word is large, the other muted. -->
                    <HorizontalStackLayout Spacing="18">
                        <Label x:Name="SpentTab" Text="spent" FontSize="24">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSpentTabTapped" /></Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="BackTab" Text="got back" FontSize="24">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTabTapped" /></Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <VerticalStackLayout x:Name="LinkBox" IsVisible="False" Spacing="6">
                        <Label Text="SETTLES (OPTIONAL)" Style="{StaticResource SectionLabel}" />
                        <c:ChipGroup x:Name="LinkChips" AllowDeselect="True" SelectionChanged="OnLinkChanged" />
                    </VerticalStackLayout>
                    <Label Text="CATEGORY" Style="{StaticResource SectionLabel}" />
                    <c:ChipGroup x:Name="CatChips" SelectionChanged="OnCategoryChanged" />
                    <c:ChipGroup x:Name="SubChips" AllowDeselect="True" IsVisible="False" />
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="TitleEntry" Placeholder="what for, e.g. groceries" ReturnType="Next" /></Border>
                        <Border Grid.Column="1" Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="AmountEntry" Placeholder="amount" Keyboard="Numeric" /></Border>
                    </Grid>
                    <!-- Person field: the avatar (a person glyph until a name is typed) says what it is; the book picks from contacts. -->
                    <Border Padding="8,4" Style="{StaticResource ControlBox}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <c:Avatar x:Name="PersonAvatar" Size="32" />
                            <Entry x:Name="PersonEntry" Grid.Column="1" Placeholder="shop, vendor or person" TextChanged="OnPersonChanged" />
                            <Label Grid.Column="2" Text="&#x1F4D2;" FontSize="22" VerticalOptions="Center" Padding="6,0" SemanticProperties.Description="pick from contacts">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnPickContactClicked" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                    <FlexLayout x:Name="PersonSuggestions" Wrap="Wrap" />
                    <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="DescriptionEntry" Placeholder="note, bill no., details" /></Border>

                    <Border Padding="12,6" Style="{StaticResource ControlBox}">
                        <Entry x:Name="TagsEntry" Placeholder="tags, e.g. home, quick" TextChanged="OnTagsChanged" />
                    </Border>
                    <FlexLayout x:Name="TagSuggestions" Wrap="Wrap" />

                    <Grid x:Name="ExpectRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="expecting some of this back" />
                            <Label Text="a loan, a deposit, a booking that may be refunded" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ExpectSwitch" Grid.Column="1" />
                    </Grid>

                    <Label Text="RECEIPT (OPTIONAL)" Style="{StaticResource SectionLabel}" />
                    <Border x:Name="ReceiptBox" IsVisible="False" Padding="4" Style="{StaticResource ControlBox}">
                        <Image x:Name="ReceiptImage" HeightRequest="180" Aspect="AspectFit" />
                    </Border>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <Button x:Name="CaptureButton" Text="📷 CAPTURE" Clicked="OnCaptureClicked" />
                        <Button Grid.Column="1" Text="🖼️ PICK" Clicked="OnPickClicked" />
                        <Button x:Name="RemoveReceiptButton" Grid.Column="2" Text="✕" IsVisible="False" Clicked="OnRemoveReceiptClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Text="SAVE" Clicked="OnSaveClicked" />
                        <Button x:Name="CancelButton" Grid.Column="1" Text="CANCEL" Clicked="OnCancelClicked" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </c:OneUiScaffold>

    <!-- Press-and-hold menu for an entry (edit, delete). -->
    <c:ActionBar x:Name="Menu" />
    </Grid>
</ContentPage>
