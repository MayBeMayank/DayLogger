<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             x:Class="DayLogger.Pages.StreakBinPage"
             Title="BIN">

    <c:OneUiScaffold Title="BIN" Subtitle="deleted streaks, history kept until you delete them forever">
        <VerticalStackLayout Padding="16" Spacing="14">
            <VerticalStackLayout x:Name="List" Spacing="8" />
            <Button x:Name="EmptyButton" Text="EMPTY BIN" Clicked="OnEmptyClicked" />
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
