<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             x:Class="DayLogger.Pages.RemindersPage"
             Title="REMINDERS">

    <c:OneUiScaffold Title="REMINDERS" Subtitle="gentle nudges, only when something is still undone">
        <VerticalStackLayout Padding="16" Spacing="14">
            <VerticalStackLayout x:Name="List" Spacing="14" />
            <Label Text="Streak reminders are set on each streak, under STREAKS." Style="{StaticResource Caption}" />
            <Label x:Name="StatusLabel" Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
