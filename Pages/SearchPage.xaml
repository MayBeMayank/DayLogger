<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             SafeAreaEdges="SoftInput"
             x:Class="DayLogger.Pages.SearchPage"
             Title="SEARCH">

    <c:OneUiScaffold x:Name="Scaffold" Title="search" Subtitle="title, note, tag, person, amount">
        <VerticalStackLayout Padding="16,8,16,120" Spacing="10">
            <Border Padding="12,6" Style="{StaticResource ControlBox}">
                <Entry x:Name="QueryEntry" Placeholder="search entries" ReturnType="Search" TextChanged="OnQueryChanged" />
            </Border>

            <Label Text="WHEN" Style="{StaticResource SectionLabel}" />
            <c:ChipGroup x:Name="WhenChips" SelectionChanged="OnFilterChanged" />
            <Grid x:Name="RangeRow" IsVisible="False" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                <Border Padding="12,2" Style="{StaticResource ControlBox}">
                    <DatePicker x:Name="FromPicker" Format="d MMM yyyy" DateSelected="OnRangeChanged" SemanticProperties.Description="from date" />
                </Border>
                <Label Grid.Column="1" Text="to" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Border Grid.Column="2" Padding="12,2" Style="{StaticResource ControlBox}">
                    <DatePicker x:Name="ToPicker" Format="d MMM yyyy" DateSelected="OnRangeChanged" SemanticProperties.Description="to date" />
                </Border>
            </Grid>

            <Label Text="CATEGORY" Style="{StaticResource SectionLabel}" />
            <c:ChipGroup x:Name="CatChips" AllowDeselect="True" SelectionChanged="OnFilterChanged" />

            <Label Text="SHOW" Style="{StaticResource SectionLabel}" />
            <c:ChipGroup x:Name="KindChips" SelectionChanged="OnFilterChanged" />

            <Label x:Name="SummaryLabel" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <VerticalStackLayout x:Name="Results" Spacing="0" Margin="-16,0" />
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
