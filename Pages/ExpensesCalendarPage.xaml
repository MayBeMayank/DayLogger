<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             x:Class="DayLogger.Pages.ExpensesCalendarPage">

    <c:OneUiScaffold x:Name="Scaffold" ManualEntrance="True" AsideBelow="True" Title="EXPENSES">
        <c:OneUiScaffold.Aside>
            <VerticalStackLayout Padding="16,0,16,16">
                <Border Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="THIS MONTH" Style="{StaticResource SectionLabel}" />
                        <Label x:Name="TotalLabel" FontAttributes="Bold" FontSize="18" />
                        <Label x:Name="SplitLabel" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </c:OneUiScaffold.Aside>

        <VerticalStackLayout Padding="16,16,16,0">
            <c:CalendarView x:Name="Calendar" DaySelected="OnDaySelected" MonthChanged="OnMonthChanged" />
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
