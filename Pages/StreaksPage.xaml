<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             SafeAreaEdges="SoftInput"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             x:Class="DayLogger.Pages.StreaksPage"
             Title="STREAKS">

    <c:OneUiScaffold x:Name="Scaffold" Title="NEW STREAK" Subtitle="tick off anything, every day">

        <VerticalStackLayout Padding="16">
            <Border Padding="12" Style="{StaticResource Section}">
                <VerticalStackLayout Spacing="10">
                    <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="NameEntry" Placeholder="name (e.g. Keep Hydrated)" ReturnType="Next" /></Border>
                    <Border Padding="12,6" Style="{StaticResource ControlBox}"><Entry x:Name="FrequencyEntry" Placeholder="times per day (e.g. 12)" Keyboard="Numeric" Text="1" TextChanged="OnFrequencyChanged" /></Border>

                    <Label x:Name="ReminderLabel" Text="REMINDERS: OFF" Style="{StaticResource Caption}" />
                    <Slider x:Name="ReminderSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="OnReminderCountChanged" />
                    <Grid x:Name="WindowRow" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="False">
                        <Label Text="from" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Padding="12,0" Style="{StaticResource ControlBox}"><TimePicker x:Name="StartPicker" Time="08:00:00" /></Border>
                        <Label Grid.Column="2" Text="to" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Border Grid.Column="3" Padding="12,0" Style="{StaticResource ControlBox}"><TimePicker x:Name="EndPicker" Time="21:00:00" /></Border>
                    </Grid>

                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Text="SAVE" Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="BinButton" Margin="0,14,0,0" Text="MOVE TO BIN" Clicked="OnBinClicked" IsVisible="False" />
        </VerticalStackLayout>
    </c:OneUiScaffold>
</ContentPage>
