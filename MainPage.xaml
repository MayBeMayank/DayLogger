<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:DayLogger.Controls"
             x:Class="DayLogger.MainPage"
             Shell.NavBarIsVisible="False"
             Title="DAYLOGGER">

    <Grid RowDefinitions="Auto,*">
        <!-- Small app title; the gap above it keeps the headers in comfortable thumb reach. -->
        <Label x:Name="AppTitle" Text="DAYLOGGER" FontSize="12" FontAttributes="Bold" CharacterSpacing="3"
               Style="{StaticResource Caption}" Margin="20,40,20,0" />

        <c:PivotView x:Name="Pivot" Grid.Row="1" Margin="0,4,0,0" SelectedChanged="OnSelectedChanged" />

        <!-- App-bar style add button: acts on whichever section is showing. -->
        <Border x:Name="AddButton" Grid.Row="1" WidthRequest="60" HeightRequest="60"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,28"
                BackgroundColor="{DynamicResource Paper}" Stroke="{DynamicResource Ink}" StrokeThickness="2"
                IsVisible="False" SemanticProperties.Description="Add">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddTapped" />
            </Border.GestureRecognizers>
            <Label Text="+" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>

        <!-- Back to the top of a long list. Mirrors the add button on the other side. -->
        <Border x:Name="TopButton" Grid.Row="1" WidthRequest="60" HeightRequest="60"
                HorizontalOptions="Start" VerticalOptions="End" Margin="24,0,0,28"
                BackgroundColor="{DynamicResource Paper}" Stroke="{DynamicResource Ink}" StrokeThickness="2"
                IsVisible="False" SemanticProperties.Description="Scroll to top">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTopTapped" />
            </Border.GestureRecognizers>
            <Label Text="↑" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>

        <!-- Press-and-hold menu for list items; sits above everything. -->
        <c:ActionBar x:Name="Menu" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
