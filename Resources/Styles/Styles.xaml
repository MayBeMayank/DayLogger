<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colours (Paper, Surface, Ink, Muted, Line, Faint, Primary, OnPrimary, Accent, PrimaryFill*)
         are filled in at runtime by ThemeService from the platform palette. Always use DynamicResource for them.
         Shape language is Metro: flat, square, type-led (see DESIGN.md). -->

    <!-- Light display face for code (pivot headers); styles below repeat it inline. -->
    <OnPlatform x:Key="FontLight" x:TypeArguments="x:String">
        <On Platform="Android" Value="sans-serif-light" />
        <On Platform="WinUI" Value="Segoe UI Light" />
        <On Platform="iOS, MacCatalyst" Value="HelveticaNeue-Light" />
    </OnPlatform>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Paper}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:String">
                    <On Platform="Android" Value="sans-serif-light" />
                    <On Platform="WinUI" Value="Segoe UI Light" />
                    <On Platform="iOS, MacCatalyst" Value="HelveticaNeue-Light" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big light line of a Metro list item. -->
    <Style x:Key="ListPrimary" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontFamily">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:String">
                    <On Platform="Android" Value="sans-serif-light" />
                    <On Platform="WinUI" Value="Segoe UI Light" />
                    <On Platform="iOS, MacCatalyst" Value="HelveticaNeue-Light" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
    </Style>

    <!-- Small uppercase heading that opens a group on a page: accent coloured so sections read as sections. -->
    <Style x:Key="SectionLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Card: flat tonal surface, square, no outline. -->
    <Style TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeShape">
            <Setter.Value><Rectangle /></Setter.Value>
        </Setter>
    </Style>

    <!-- Input / chip / tick box: outlined field. -->
    <Style x:Key="ControlBox" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Paper}" />
        <Setter Property="StrokeShape">
            <Setter.Value><Rectangle /></Setter.Value>
        </Setter>
    </Style>

    <!-- Control surface: accent-tinted tile (forms, tappable cards). -->
    <Style x:Key="Section" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeShape">
            <Setter.Value><Rectangle /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,10" />
        <!-- A label that wraps grows the button; see the Button handler tweak in MauiProgram. -->
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
</ResourceDictionary>
