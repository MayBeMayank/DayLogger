<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DayLogger.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DayLogger"
    Title="DayLogger"
    Shell.BackgroundColor="{DynamicResource Paper}"
    Shell.ForegroundColor="{DynamicResource Ink}"
    Shell.TitleColor="{DynamicResource Ink}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
